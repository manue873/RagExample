# =======================================================
# RAGModel - Variables de Entorno del Sistema
# =======================================================

# Clave de API de Groq Cloud (Obligatoria para la inferencia)
# Obtener en https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui

# Modelo asignado en Groq Cloud
GROQ_MODEL=qwen/qwen3.8-27b

# Control de frecuencia por IP (Rate Limiting)
RATE_LIMIT_PER_MINUTE=5/minute
RATE_LIMIT_PER_HOUR=30/hour
